{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM", "ESNext.Disposable"],
    "strict": true, "skipLibCheck": false, "declaration": true,
    "noEmitOnError": true, "rootDir": "src", "outDir": "dist"
  },
  "include": ["src/**/*.ts"]
}
